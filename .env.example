# ── Base de données (Neon Postgres) ─────────────────────────────────────────
# URL poolée pour l'app (driver neon-http) :
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/kyb?sslmode=require
# URL directe non-poolée pour migrations & enrich transactionnel (recommandé) :
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/kyb?sslmode=require

# ── Mode démo ────────────────────────────────────────────────────────────────
# true (défaut) → les connecteurs renvoient des fixtures locales (zéro clé requise).
NEXT_PUBLIC_DEMO_MODE=true

# ── INSEE Sirene (connecteur RÉEL) ───────────────────────────────────────────
# Compte sur https://portail-api.insee.fr/ → souscrire l'app à « API Sirene (V3.11) » → générer la clé.
INSEE_SIRENE_API_KEY=
INSEE_SIRENE_BASE_URL=https://api.insee.fr/api-sirene/3.11
# Le nom du header est figé dans le code (X-INSEE-Api-Key-Integration) ; vérifier la casse sur le portail.

# ── BODACC (connecteur RÉEL, sans clé) ───────────────────────────────────────
BODACC_BASE_URL=https://bodacc-datadila.opendatasoft.com/api/explore/v2.1
# Clé Opendatasoft optionnelle pour relever les limites de débit :
BODACC_API_KEY=

# ── INPI / RNE (live : login JWT → /companies/{siren}) ───────────────────────
# Sans credentials → fixture. Avec credentials + NEXT_PUBLIC_DEMO_MODE=false → live.
INPI_USERNAME=
INPI_PASSWORD=
# INPI_BASE_URL=https://registre-national-entreprises.inpi.fr/api  # défaut
# Garde-fou CJUE 2022 : n'expose les UBO réels dans le graphe que si "true".
# Ne passer à "true" qu'après auth (Étape 2.2) + log d'intérêt légitime (3.4).
INPI_EXPOSE_UBO=false

# ── DG Trésor – Registre national des gels (API publique ; mock par défaut) ──
# Sans clé, mais un User-Agent est obligatoire (posé par le connecteur). Le
# fichier publié pèse plus de 10 Mo : il est téléchargé côté serveur et gardé en
# cache 6 h ; seules les correspondances sont enregistrées.
TRESOR_GELS_ENABLED=false
TRESOR_GELS_BASE_URL=https://gels-avoirs.dgtresor.gouv.fr/ApiPublic/api/v1

# ── OpenSanctions (sanctions + PEP agrégées) ─────────────────────────────────
# Sans clé → fixture. Vérifier la licence : l'usage commercial est payant.
OPENSANCTIONS_API_KEY=
# OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
# OPENSANCTIONS_DATASET=sanctions

# ── Connecteurs ouverts, sans clé (opt-in : false par défaut) ────────────────
# Passer à "true" pour interroger l'API réelle (hors mode démo uniquement).
# GLEIF : référentiel LEI, sociétés mères transfrontalières
GLEIF_ENABLED=false
# VIES : validation TVA intracommunautaire (Commission UE)
VIES_ENABLED=false
# BAN : Base Adresse Nationale, normalisation des adresses
BAN_ENABLED=false
# GDELT : presse / adverse media
GDELT_ENABLED=false

# ── Pappers (agrégateur commercial : bilans, dirigeants) ─────────────────────
# Plan gratuit : 2 000 appels/mois. Actif seulement si flag ET clé sont posés.
PAPPERS_ENABLED=false
PAPPERS_API_KEY=

# ── Recherche d'entreprises (DINUM, gratuit, SANS clé) ───────────────────────
# Dirigeants publiés au RNE, derniers comptes, indicateurs publics (bio, RGE,
# Qualiopi…). 7 requêtes/s/IP. Prend le relais de l'INPI et de Pappers.
# ⚠️ Appliquer d'abord la migration drizzle/0010 (valeur d'enum source_kind).
RECHERCHE_ENTREPRISES_ENABLED=false

# ── Companies House (Royaume-Uni, gratuit) ───────────────────────────────────
# Second saut : dirigeants / contrôle des sociétés mères britanniques repérées
# par GLEIF. Clé : https://developer.company-information.service.gov.uk/
# (application « live », clé de type REST). Actif seulement si flag ET clé posés.
# ⚠️ Appliquer d'abord la migration drizzle/0009 (valeur d'enum source_kind).
COMPANIES_HOUSE_ENABLED=false
COMPANIES_HOUSE_API_KEY=

# ── Résolution d'entités ─────────────────────────────────────────────────────
# builtin (défaut, TypeScript) ou splink (sidecar Python, à raccorder).
RESOLVER_BACKEND=builtin

# ── Observabilité & tâches planifiées ────────────────────────────────────────
SENTRY_DSN=
# Protège la route /api/cron/refresh (même esprit que EXPORT_TOKEN).
CRON_SECRET=

# ── Exports (PDF / JSON / pack de preuve ZIP) ────────────────────────────────
# Gate optionnelle par jeton partagé (même esprit que CRON_SECRET) : si défini,
# les routes d'export exigent ?token=<valeur>. Vide (défaut) → exports publics
# (mode démo zéro-clé). L'auth utilisateur réelle arrive à l'Étape 2.2.
EXPORT_TOKEN=
